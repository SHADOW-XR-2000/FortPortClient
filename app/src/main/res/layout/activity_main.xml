<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/fp_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/fp_background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/offlineImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:maxWidth="280dp"
            android:maxHeight="280dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/offline_title" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/fp_on_background"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />

    </LinearLayout>

    <!-- Нативный список друзей: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeFriendsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeFriendsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/friendsSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/friendsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="136dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chat_card">

            <EditText
                android:id="@+id/friendsSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Поиск пользователей..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/fp_chat_name"
                android:textColorHint="@color/fp_chat_sub"
                android:textSize="16sp" />

        </FrameLayout>

    </FrameLayout>

    <!-- Нативная основная лента: поверх WebView, между обычными верхней и нижней панелями. -->
    <FrameLayout
        android:id="@+id/nativeFeedPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeFeedBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/feedSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/feedRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="78dp"
                android:paddingEnd="8dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Нативная лента пользователя (концепция 4): между обычными верхней и нижней панелями. -->
    <FrameLayout
        android:id="@+id/nativeProfilePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeProfileBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/profileSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profileRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="78dp"
                android:paddingEnd="8dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Нативная лента порта (концепция 5): между обычными верхней и нижней панелями. -->
    <FrameLayout
        android:id="@+id/nativePortPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativePortBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/portSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/portRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="78dp"
                android:paddingEnd="8dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Нативные уведомления: под шапкой раздела, над своей нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeNotifsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeNotifsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/notifsSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notifsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="78dp"
                android:paddingEnd="8dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Нативные настройки профиля: без нижней панели; содержимое строится в SettingsController. -->
    <FrameLayout
        android:id="@+id/nativeSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeSettingsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/settingsHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Нативные страницы порта (создание и настройка): без нижней панели; содержимое строится в PortSettingsController. -->
    <FrameLayout
        android:id="@+id/nativePortSettingsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativePortSettingsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/portSettingsHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Нативные текстовые страницы (Поддержка, О нас, Конфиденциальность, Условия): содержимое строится в InfoPageController. -->
    <FrameLayout
        android:id="@+id/nativeInfoPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeInfoBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/infoHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Нативная страница открытого поста: без нижней панели, сверху — стрелка «назад». -->
    <FrameLayout
        android:id="@+id/nativePostPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativePostBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/postSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/postRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="78dp"
                android:paddingEnd="8dp"
                android:paddingBottom="16dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Нативный список переписок: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeChatsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeChatsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/chatsSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="82dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/chatsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_chat_card"
            android:padding="16dp"
            android:textColor="@color/fp_chat_name"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Нативный список портов: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeCommunitiesPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeCommunitiesBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/communitiesSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/communitiesRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="136dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chat_card">

            <EditText
                android:id="@+id/communitiesSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Поиск портов..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/fp_chat_name"
                android:textColorHint="@color/fp_chat_sub"
                android:textSize="16sp" />

        </FrameLayout>

    </FrameLayout>

    <!-- Нативная музыка: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeMusicPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeMusicBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Диск по центру экрана и по ширине; крутится, пока играет музыка. -->
        <ImageView
            android:id="@+id/musicDisc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:alpha="0.9"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/musicSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/musicRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="260dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/musicEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_chat_card"
            android:padding="16dp"
            android:text="В библиотеке пока нет аудио.\nНажмите кнопку загрузки вверху справа"
            android:gravity="center"
            android:textColor="@color/fp_chat_name"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Плеер: всплывающая плашка, список под ней прокручивается. -->
        <LinearLayout
            android:id="@+id/musicPlayerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_music_player"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <ru.fortport.client.MarqueeTextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="@color/fp_chat_name"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/fp_chat_sub"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/musicTimeCurrent"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/fp_chat_sub"
                    android:textSize="12sp" />

                <ru.fortport.client.GradientSeekBar
                    android:id="@+id/musicSeek"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/musicTimeTotal"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="@color/fp_chat_sub"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/musicShuffle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Случайное проигрывание"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_random" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/musicPrev"
                    android:layout_width="76dp"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Предыдущий трек"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_previous" />

                <ImageButton
                    android:id="@+id/musicPlay"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Воспроизведение"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_play" />

                <ImageButton
                    android:id="@+id/musicNext"
                    android:layout_width="76dp"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Следующий трек"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/musicRepeat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Повтор трека"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_repeat" />

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/topNavBar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/fp_topbar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/fp_topbar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/sectionHeaderIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/sectionHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sectionHeaderAction"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Загрузить аудио с устройства"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/audio_upload"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/postTopBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/fp_topbar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/postBackButton"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chat_btn"
            android:contentDescription="Назад"
            android:gravity="center"
            android:text="←"
            android:textColor="#2AF5C0"
            android:textSize="28sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Верхняя панель настроек: стрелка «назад», иконка шестерни (assets/ui/icons/setting_icon.png) и название. -->
    <LinearLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#262626"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/settingsBackButton"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chat_btn"
            android:contentDescription="Назад"
            android:gravity="center"
            android:text="←"
            android:textColor="#2AF5C0"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/settingsTopIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/nav_settings"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Верхняя панель страниц порта: стрелка «назад», иконка «Порты» и название («Новый порт» / «Настройка порта»). -->
    <LinearLayout
        android:id="@+id/portSettingsTopBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#262626"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/portSettingsBackButton"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chat_btn"
            android:contentDescription="Назад"
            android:gravity="center"
            android:text="←"
            android:textColor="#2AF5C0"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/portSettingsTopIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/portSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Верхняя панель текстовых страниц: стрелка «назад», иконка и название страницы. -->
    <LinearLayout
        android:id="@+id/infoTopBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#262626"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/infoBackButton"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chat_btn"
            android:contentDescription="Назад"
            android:gravity="center"
            android:text="←"
            android:textColor="#2AF5C0"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/infoTopIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/infoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/fp_surface"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Кнопка в левом углу нижней панели раскрывает меню пользователя (UserMenu). -->
        <ImageButton
            android:id="@+id/navMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/nav_icon_frame"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/nav_profile" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/navMusic"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_music"     android:visibility="gone" />

        <ImageButton
            android:id="@+id/navCommunities"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_communities"     android:visibility="gone" />

        <View
            android:id="@+id/navGapDividerLeft"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#55808080"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/navCenterSlot"
            android:layout_width="72dp"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageButton
                android:id="@+id/navAddPost"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/nav_add_post" />

            <!-- «Домой» занимает место кнопки поста в разделах, где постить нельзя. -->
            <ImageButton
                android:id="@+id/navHomeCenter"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/home_icon"
                android:visibility="gone"
                android:contentDescription="@string/nav_home" />

        </FrameLayout>

        <View
            android:id="@+id/navGapDividerRight"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#55808080"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Уведомления — в правом углу нижней панели. -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp">

            <ImageButton
                android:id="@+id/navNotifs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/nav_icon_frame_rounded"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/nav_notifs" />

            <TextView
                android:id="@+id/navNotifBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/notif_badge_bg"
                android:gravity="center"
                android:minWidth="16dp"
                android:minHeight="16dp"
                android:paddingHorizontal="3dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/navFriends"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_friends"     android:visibility="gone" />

        <ImageButton
            android:id="@+id/navChats"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_chats"     android:visibility="gone" />

    </LinearLayout>

    <!-- Нижняя панель уведомлений: «Прочитать всё», «Домой», «Обновить». -->
    <LinearLayout
        android:id="@+id/notifBottomBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/fp_surface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/notifReadAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Прочитать всё"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#55808080" />

        <ImageButton
            android:id="@+id/notifHome"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/home_icon"
            android:contentDescription="@string/nav_home" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#55808080" />

        <TextView
            android:id="@+id/notifRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Обновить"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
