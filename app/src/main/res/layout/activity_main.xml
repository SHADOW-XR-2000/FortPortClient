<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/fp_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/offlineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/fp_background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/offlineImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:maxWidth="280dp"
            android:maxHeight="280dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/offline_title" />

        <TextView
            android:id="@+id/offlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_title"
            android:textColor="@color/fp_on_background"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry" />

    </LinearLayout>

    <!-- Нативный список друзей: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeFriendsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeFriendsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/friendsSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/friendsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="136dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chat_card">

            <EditText
                android:id="@+id/friendsSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Поиск пользователей..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/fp_chat_name"
                android:textColorHint="@color/fp_chat_sub"
                android:textSize="16sp" />

        </FrameLayout>

    </FrameLayout>

    <!-- Нативный список переписок: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeChatsPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeChatsBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/chatsSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chatsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="82dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/chatsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_chat_card"
            android:padding="16dp"
            android:textColor="@color/fp_chat_name"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Нативный список портов: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeCommunitiesPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeCommunitiesBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/communitiesSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/communitiesRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="136dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chat_card">

            <EditText
                android:id="@+id/communitiesSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Поиск портов..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/fp_chat_name"
                android:textColorHint="@color/fp_chat_sub"
                android:textSize="16sp" />

        </FrameLayout>

    </FrameLayout>

    <!-- Нативная музыка: поверх WebView, под шапкой раздела и нижней панелью. -->
    <FrameLayout
        android:id="@+id/nativeMusicPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#C7EAF5"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/nativeMusicBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Диск по центру экрана и по ширине; крутится, пока играет музыка. -->
        <ImageView
            android:id="@+id/musicDisc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:alpha="0.9"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/musicSwipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/musicRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="260dp"
                android:paddingEnd="12dp"
                android:paddingBottom="72dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/musicEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_chat_card"
            android:padding="16dp"
            android:text="В библиотеке пока нет аудио.\nНажмите кнопку загрузки вверху справа"
            android:gravity="center"
            android:textColor="@color/fp_chat_name"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Плеер: всплывающая плашка, список под ней прокручивается. -->
        <LinearLayout
            android:id="@+id/musicPlayerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_music_player"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <ru.fortport.client.MarqueeTextView
                android:id="@+id/musicTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="@color/fp_chat_name"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/musicArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/fp_chat_sub"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/musicTimeCurrent"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/fp_chat_sub"
                    android:textSize="12sp" />

                <ru.fortport.client.GradientSeekBar
                    android:id="@+id/musicSeek"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/musicTimeTotal"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="@color/fp_chat_sub"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/musicShuffle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Случайное проигрывание"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_random" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/musicPrev"
                    android:layout_width="76dp"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Предыдущий трек"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_previous" />

                <ImageButton
                    android:id="@+id/musicPlay"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Воспроизведение"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_play" />

                <ImageButton
                    android:id="@+id/musicNext"
                    android:layout_width="76dp"
                    android:layout_height="52dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Следующий трек"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_next" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/musicRepeat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Повтор трека"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/audio_repeat" />

            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/topNavBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/fp_topbar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/navHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/nav_icon_frame"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/nav_home" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/navCoins"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/nav_icon_frame_rounded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/navCoinsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/nav_coins" />

            <TextView
                android:id="@+id/navCoinsValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="—"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageButton
                android:id="@+id/navNotifs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/nav_icon_frame_rounded"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/nav_notifs" />

            <TextView
                android:id="@+id/navNotifBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/notif_badge_bg"
                android:gravity="center"
                android:minWidth="16dp"
                android:minHeight="16dp"
                android:paddingHorizontal="3dp"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:visibility="gone" />

        </FrameLayout>

        <View
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/nav_icon_frame_rounded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/navProfileAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/avatar_placeholder"
                android:scaleType="centerCrop"
                android:contentDescription="@string/nav_profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▼"
                android:textColor="@android:color/white"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/fp_topbar_bg"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/sectionHeaderIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/sectionHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/sectionHeaderAction"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Загрузить аудио с устройства"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/audio_upload"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/fp_surface"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/navMusic"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_music" />

        <ImageButton
            android:id="@+id/navCommunities"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_communities" />

        <View
            android:id="@+id/navGapDividerLeft"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#55808080"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/navCenterSlot"
            android:layout_width="72dp"
            android:layout_height="60dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageButton
                android:id="@+id/navAddPost"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/nav_add_post" />

            <!-- «Домой» занимает место кнопки поста в разделах, где постить нельзя. -->
            <ImageButton
                android:id="@+id/navHomeCenter"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_home"
                android:visibility="gone"
                android:contentDescription="@string/nav_home" />

        </FrameLayout>

        <View
            android:id="@+id/navGapDividerRight"
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#55808080"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/navFriends"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_friends" />

        <ImageButton
            android:id="@+id/navChats"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/nav_chats" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
