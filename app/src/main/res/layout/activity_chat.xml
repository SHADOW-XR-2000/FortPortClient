<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2E38"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#23252C"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/chatBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chat_back"
            android:contentDescription="Назад к списку переписок"
            android:gravity="center"
            android:text="←"
            android:textColor="#9CC7E8"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/chatAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:foreground="@drawable/bg_avatar_border"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8E9AB0"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/chatLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingVertical="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1E24"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chatReplyBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chatReplyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9CC7E8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chatReplyClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#C5D2E3"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chatAttachInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingTop="6dp"
            android:textColor="#9CC7E8"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/chatAttach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Прикрепить файл"
                android:gravity="center"
                android:text="📎"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="Сообщение..."
                android:imeOptions="flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="44dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E9AB0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chatSend"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chat_btn"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingHorizontal="14dp"
                android:text="➤"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
