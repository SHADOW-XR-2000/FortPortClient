<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FortPort" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fp_primary</item>
        <item name="colorPrimaryDark">@color/fp_primary_dark</item>
        <item name="colorAccent">@color/fp_accent</item>
        <item name="android:windowBackground">@color/fp_background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/fp_primary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.FortPort.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FortPort.Dialog</item>
    </style>

    <!-- Диалоги (форма нового поста, жалобы, награды, подтверждения): фон и цвета берутся из
         ресурсов, у которых есть ночной вариант, поэтому в тёмной теме окно не остаётся белым. -->
    <style name="ThemeOverlay.FortPort.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorPrimary">@color/fp_accent</item>
        <item name="colorSecondary">@color/fp_accent</item>
        <item name="colorSurface">@color/fp_dialog_bg</item>
        <item name="colorOnSurface">@color/fp_on_background</item>
        <item name="android:colorBackground">@color/fp_dialog_bg</item>
        <item name="android:textColorPrimary">@color/fp_on_background</item>
        <item name="android:textColorSecondary">@color/fp_chat_sub</item>
        <item name="android:textColorHint">@color/fp_chat_time</item>
        <item name="colorControlNormal">@color/fp_chat_sub</item>
        <item name="colorControlActivated">@color/fp_accent</item>
    </style>
</resources>
