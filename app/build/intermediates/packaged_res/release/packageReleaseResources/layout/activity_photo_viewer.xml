<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fp_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Верхняя строка: закрыть + аватар и ник автора -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/viewerClose"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/viewerAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Аватар автора"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/viewerNick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/fp_on_background"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Фото + стрелки переключения -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ru.fortport.client.ZoomImageView
            android:id="@+id/viewerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/viewerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/viewerError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:textColor="@color/fp_on_background"
            android:textSize="15sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/viewerPrev"
            android:layout_width="48dp"
            android:layout_height="64dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/viewer_arrow_bg"
            android:contentDescription="Предыдущее фото"
            android:src="@drawable/ic_viewer_prev"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/viewerNext"
            android:layout_width="48dp"
            android:layout_height="64dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/viewer_arrow_bg"
            android:contentDescription="Следующее фото"
            android:src="@drawable/ic_viewer_next"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Нижняя строка: сохранить себе (слева) и скачать (справа) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/viewerFavorite"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Сохранить себе"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/viewerDownload"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Скачать на устройство"
            android:padding="10dp"
            android:scaleType="fitCenter" />
    </FrameLayout>
</LinearLayout>
